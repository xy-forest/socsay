# MiMo API Key
MIMO_API_KEY=your_api_key_here
# MiMo 模型名
MIMO_MODEL=MiMo-V2.5
# 文档推荐模型名（OpenAI/Anthropic 示例）
MIMO_MODEL_DOC=mimo-v2.5-pro
